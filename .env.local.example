# ============================================================================
# SUPABASE SETUP (one-time, ~3 minutes)
# ----------------------------------------------------------------------------
#  1. Go to https://supabase.com -> "New project". Give it a name + a strong
#     database password. Wait ~30 seconds for the project to provision.
#  2. In the project sidebar open: Project Settings -> API.
#  3. Copy "Project URL" into NEXT_PUBLIC_SUPABASE_URL below.
#  4. Copy the "anon public" key into NEXT_PUBLIC_SUPABASE_ANON_KEY below.
#     (Do NOT use the service_role key here — it bypasses RLS.)
#  5. Open SQL Editor -> New query, paste the contents of
#       supabase/migrations/0001_init.sql
#     and click Run. This creates the profiles + tutor_profiles +
#     student_profiles tables and the signup trigger.
#  6. Copy this file to .env.local in the project root and fill in the values.
#  7. Restart `npm run dev` so Next.js picks up the new env vars.
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
